<Window x:Class="CurrencyConverter_Static.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CurrencyConverter_Static" xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="Currrency Converter" Height="600" Width="1000" WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="1000" MaxHeight="800" MaxWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="3" Width="800" CornerRadius="10" BorderThickness="5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,0">
                    <GradientStop Color="#ec2075" Offset="0.0"/>
                    <GradientStop Color="#f33944" Offset="0.5"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Rectangle Grid.Row="3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#ec2075" Offset="0.0"/>
                        <GradientStop Color="#f33944" Offset="0.5"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Border>

        <StackPanel Grid.Row="0" Width="1000" Height="50" Orientation="Vertical">
            <Label Content="Currency Converter" HorizontalContentAlignment="Center" 
           VerticalContentAlignment="Center" FontSize="30" Foreground="#FFEC2075" />
        </StackPanel>
        
        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Left" 
                    Height="80" Width="1000" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Label Height="40" Width="1000" HorizontalContentAlignment="Center" 
                   VerticalContentAlignment="Center" Content="Converted Currency..." FontSize="20" BorderBrush="#FF5C5353" BorderThickness="0.5"/>
            <Label Name="lblCurrency" Height="40" Width="1000" HorizontalContentAlignment="Center" 
                   VerticalContentAlignment="Center" FontSize="20" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="left" 
                    VerticalAlignment="Top" Height="60" Width="800" Grid.ColumnSpan="2" Margin="100,0,0,0">
            <Label Height="40" Width="150" Content="Enter Amount :" Margin="35 0 0 0" 
                   VerticalAlignment="Bottom" Foreground="White" FontSize="20"/>
            <Label Height="40" Width="150" Content="From :" Margin="110 0 0 0" 
                   VerticalAlignment="Bottom" Foreground="White" FontSize="20"/>
            <Label Height="40" Width="150" Content="To :" Margin="130 0 0 0" 
                   VerticalAlignment="Bottom" Foreground="White" FontSize="20"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Height="80" Width="800" 
                    VerticalAlignment="Top" Margin="0,65,0,0" >
            <TextBox Name="txtCurrency" Height="30" Width="200" Margin="40 0 0 0" FontSize="18" 
                     VerticalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox" VerticalAlignment="Top"/>
            <ComboBox Name="cmbFromCurrency" Width="170" Height="30" Margin="60 0 40 0" FontSize="15" 
                      VerticalContentAlignment="Center" VerticalAlignment="Top" MaxDropDownHeight="150"/>
            <fa:ImageAwesome Icon="Exchange" Height="30" Width="30" Foreground="White" 
                             VerticalAlignment="Top"/>
            <ComboBox Name="cmbToCurrency" Width="170" Height="30" Margin="40 0 0 0" FontSize="15" 
                      VerticalContentAlignment="Center" VerticalAlignment="Top" MaxDropDownHeight="150"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Height="100" Width="1000" Orientation="Horizontal">
            <Button Name="Convert" Content="Convert" Click="Convert_Click" Height="40" Width="150" Margin="350 0 20 0"
                    Foreground="White" FontSize="20" Style="{StaticResource ButtonRound}">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#ec2075" Offset="0.0"/>
                        <GradientStop Color="#f33944" Offset="0.5"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <Button Name="Clear" Content="Clear" Click="Clear_Click" Height="40" Width="150" 
                    Foreground="White" FontSize="20" Style="{StaticResource ButtonRound}">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#ec2075" Offset="0.0"/>
                        <GradientStop Color="#f33944" Offset="0.5"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="5" Height="150" Width="800" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Image Height="150" Width="150" Source="/Images/Winsty boy.png" 
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="325 0"/>
        </StackPanel>
    </Grid>
</Window>
